# Copy to .env.local (local) or set in your host's environment settings (Vercel, Netlify…).
# All three are optional; app/data/site.ts holds the fallbacks.

# Production origin, no trailing slash. Used for canonical URLs, Open Graph,
# the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://yourmomstudio.com

# Where every "Book a call" button goes. Defaults to the Calendly business
# meeting; a calendly.com link opens in the on-page booking modal, any other
# URL (Cal.com, HubSpot…) opens as a normal link in a new tab.
NEXT_PUBLIC_BOOKING_URL=

# Google Tag Manager container (GTM-XXXXXXX). Load GA4, Google Ads and Meta
# conversion tags from GTM. Every CTA carries a data-cta attribute
# (book-call-hero, book-call-header, book-call-pricing…) to use as a click trigger,
# and the booking modal pushes two dataLayer events with the same `cta` value:
#   book_call_open       the modal opened
#   book_call_scheduled  a meeting was booked in Calendly — use this as the
#                        Google Ads / Meta conversion
NEXT_PUBLIC_GTM_ID=
